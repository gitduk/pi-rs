# Copy to ~/.pi/.env and `chmod 600` it. One NAME=value a line, read
# literally: no `$` expansion, no `export`. Every script tool starts with
# these in its environment; a checkout's `.pi/.env` does the same for the tools
# under its `.pi/tools`, and `$NAME` in settings.toml reads this file too. A
# variable already set in pi's own environment wins over the file.

# judge: the judgment endpoint's key, and optional overrides.
TYPESAFE_API_KEY=
# JUDGE_BASE_URL=https://api.typesafe.ai/v1
# JUDGE_MODEL=jev-latest

# telegram: the bot's token, from @BotFather.
TELEGRAM_BOT_TOKEN=
