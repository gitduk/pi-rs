#!/usr/bin/env python3
# ---
# description = "Ask the user a question with options when the decision belongs to them.\nExamples include choosing an approach, deciding whether to proceed, or selecting the next action.\nAsk only when the request, code, and reasonable defaults do not answer the question.\nThe answer must change your next action.\nOtherwise, choose the ordinary option, state it briefly, and continue.\nSupply at least two meaningful alternatives. If only one action remains, state it briefly and continue without calling this tool.\nIf two applicable user rules conflict without stated precedence, ask the user to decide.\n\nWrite each option as the exact message the user would send to select it.\nUse words addressed to you or an available pi command.\nA selected command executes as if the user typed it.\nPut your recommended option first.\nThe user can select several text options, delivered together as one message with one option per line.\nA command must be selected alone.\n\nThe call returns immediately. End your turn after a successful call.\nThe selection, or text the user writes instead, arrives as their next message."
# [required]
# question = "Write one short sentence."
# options = "Supply 2 to 9 meaningful alternatives, one per line. Each option must be the exact one-line message that selects it."
# ---
# The question goes to pi on fd 3 and the call ends: pi answers each `choose`
# with one line, `{"asked": true}` once it is up, or an `error` saying why not.
import json
import os
import sys


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def main():
    try:
        call = json.load(sys.stdin)
    except ValueError:
        fail("no call on stdin")
    options = call.get("options")
    # The schema says a string, a line each; a model may still send a list.
    if isinstance(options, str):
        options = [o for o in options.splitlines() if o.strip()]
    if not isinstance(options, list):
        fail("`options` is one option per line")
    if len(options) < 2:
        fail("supply at least two meaningful alternatives; if only one action remains, state it and continue without choose")
    fd = os.environ.get("PI_EVENTS_FD")
    if fd is None:
        fail("not run by pi: there is no one here to ask")
    asked = {
        "choose": call.get("question") or "",
        "options": options,
    }
    # A socket, so no "r+": that wants a file it can seek. One end each way.
    with os.fdopen(os.dup(int(fd)), "w", buffering=1) as to_pi:
        to_pi.write(json.dumps(asked) + "\n")
    with os.fdopen(os.dup(int(fd)), "r") as from_pi:
        said = json.loads(from_pi.readline() or "{}")
    if not said.get("asked"):
        fail(f"not put to the user: {said.get('error', 'pi gave no answer')}")
    print(f"Put to the user with {len(options)} options. End your turn now.")


main()
