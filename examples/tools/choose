#!/usr/bin/env python3
# ---
# description = "Ask the user a question with options when the decision belongs to them.\nExamples include choosing an approach, deciding whether to proceed, or selecting the next action.\nAsk only when the request, code, and reasonable defaults do not answer the question.\nThe answer must change your next action.\n\nIf the request, code, or reasonable defaults answer the question, choose the ordinary option.\nIn that case, state your choice briefly.\nIn that case, continue without this tool.\n\nSupply at least two meaningful alternatives.\nIf only one action remains, state it briefly.\nContinue without this tool in that case.\nIf two applicable user rules conflict without stated precedence, ask the user to decide.\n\nWrite each option as the exact message the user would send to select it.\nUse words addressed to you or an available pi command.\nA selected command executes as if the user typed it.\nPut your recommended option first.\n\nThe user can select several text options.\npi delivers those options as one message, one option per line.\nThe user must select a command alone.\n\nThe call returns immediately.\nEnd your turn after a successful call.\nThe selection, or text the user writes instead, arrives as their next message."
# [required]
# question = "Write one short sentence."
# options = "Supply 2 to 9 meaningful alternatives, one per line. Each option must be the exact one-line message that selects it."
# ---
# The question goes to pi on fd 3 and the call ends: pi answers each `choose`
# with one line, `{"asked": true}` once it is up, or an `error` saying why not.
import json
import os
import sys


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def main():
    try:
        call = json.load(sys.stdin)
    except ValueError:
        fail("no call on stdin")
    options = call.get("options")
    # The schema says a string, a line each; a model may still send a list.
    if isinstance(options, str):
        options = [o for o in options.splitlines() if o.strip()]
    if not isinstance(options, list):
        fail("`options` is one option per line")
    if len(options) < 2:
        fail("Supply at least two meaningful alternatives. If only one action remains, state it briefly. Continue without `choose` in that case.")
    fd = os.environ.get("PI_EVENTS_FD")
    if fd is None:
        fail("not run by pi: there is no one here to ask")
    asked = {
        "choose": call.get("question") or "",
        "options": options,
    }
    # A socket, so no "r+": that wants a file it can seek. One end each way.
    with os.fdopen(os.dup(int(fd)), "w", buffering=1) as to_pi:
        to_pi.write(json.dumps(asked) + "\n")
    with os.fdopen(os.dup(int(fd)), "r") as from_pi:
        said = json.loads(from_pi.readline() or "{}")
    if not said.get("asked"):
        fail(f"not put to the user: {said.get('error', 'pi gave no answer')}")
    print(f"Put to the user with {len(options)} options. End your turn now.")


main()
