#!/usr/bin/env python3
# ---
# description = "Leave yourself a prompt that comes back to this checkout as a turn of its own, after a delay or on a period. It arrives once nothing else is running, so end this turn rather than wait for it. Give `prompt` and one of `after` or `every`. It lasts while pi runs; `jobs` lists it and stops it. To come back when a command ends, run it with bash's `background` instead."
# [args]
# prompt = "What to do when it comes due, written as a request: it arrives with nothing of this turn but what you put in it."
# after = "optional: a delay, 30s / 10m / 2h / 1d"
# every = "optional: a period, at least 1m"
# ---
# An example of a tool that outlives its call: it detaches over fd 3 and
# reports each time the prompt comes due, as `{"result": ...}`.
import json
import os
import sys
import time

UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def span(spec):
    unit, count = spec[-1:], spec[:-1].strip()
    if unit not in UNITS or not count.isdigit():
        fail(f"`{spec}` is not a span like 30s, 10m, 2h or 1d")
    seconds = int(count) * UNITS[unit]
    if seconds > 365 * 86400:
        fail(f"`{spec}` is longer than a year")
    return seconds


def say(fd3, **message):
    fd3.write(json.dumps(message) + "\n")
    fd3.flush()


def main():
    if os.environ.get("PI_EVENTS_FD") != "3":
        fail("later needs pi to keep it running: no fd 3 here")
    args = json.load(sys.stdin)
    prompt = (args.get("prompt") or "").strip()
    after = (args.get("after") or "").strip()
    every = (args.get("every") or "").strip()
    if not prompt:
        fail("`prompt` says what to do when it comes due")
    if bool(after) == bool(every):
        fail("give exactly one of `after` or `every`")

    fd3 = os.fdopen(3, "w")
    if after:
        seconds = span(after)
        say(fd3, detach=f"set: back in {after}, so this turn can end")
        time.sleep(seconds)
        say(fd3, result=prompt)
        return
    seconds = span(every)
    if seconds < 60:
        fail("`every` is at least 1m")
    say(fd3, detach=f"set: back every {every} until stopped, so this turn can end")
    while True:
        say(fd3, status=f"next in {every}")
        time.sleep(seconds)
        say(fd3, result=prompt)


main()
