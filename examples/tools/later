#!/usr/bin/env python3
# ---
# description = "Leave yourself a prompt that comes back to this checkout as a turn of its own: after a delay, on a period, or when a background command exits — a CI run, a deploy, a long build. It arrives once nothing else is running, so end this turn rather than wait for it. Give `prompt` and one of `after`, `every` or `when_done`. It lasts while pi runs; `jobs` lists it and stops it."
# [args]
# prompt = "What to do when it comes due, written as a request: it arrives with nothing of this turn but what you put in it."
# after = "optional: a delay, 30s / 10m / 2h / 1d"
# every = "optional: a period, at least 1m"
# when_done = "optional: a shell command run in the background from the workspace root; its exit status and the end of its output come with the prompt"
# ---
# An example of a tool that outlives its call: it detaches over fd 3 and
# reports each time the prompt comes due, as `{"result": ...}`.
import json
import os
import subprocess
import sys
import time

UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}
TAIL = 4096


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def span(spec):
    unit, count = spec[-1:], spec[:-1].strip()
    if unit not in UNITS or not count.isdigit():
        fail(f"`{spec}` is not a span like 30s, 10m, 2h or 1d")
    seconds = int(count) * UNITS[unit]
    if seconds > 365 * 86400:
        fail(f"`{spec}` is longer than a year")
    return seconds


def say(fd3, **message):
    fd3.write(json.dumps(message) + "\n")
    fd3.flush()


# The command runs without the keys `.env` gave this script: those are the
# tools', and what the command prints comes back to the model.
def clean_env():
    env = dict(os.environ)
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".env")
    try:
        with open(path) as f:
            for line in f:
                key = line.split("=", 1)[0].strip()
                if "=" in line and not line.lstrip().startswith("#"):
                    env.pop(key, None)
    except OSError:
        pass
    return env


def watch(command):
    run = subprocess.run(
        ["sh", "-c", command],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        env=clean_env(),
    )
    text = run.stdout[-TAIL:].decode(errors="replace").strip()
    status = f"exit status: {run.returncode}"
    if not text:
        return f"`{command}` {status}, printing nothing."
    return f"`{command}` {status}. The end of its output:\n```\n{text}\n```"


def main():
    if os.environ.get("PI_EVENTS_FD") != "3":
        fail("later needs pi to keep it running: no fd 3 here")
    args = json.load(sys.stdin)
    prompt = (args.get("prompt") or "").strip()
    given = {k: (args.get(k) or "").strip() for k in ("after", "every", "when_done")}
    given = {k: v for k, v in given.items() if v}
    if not prompt:
        fail("`prompt` says what to do when it comes due")
    if len(given) != 1:
        fail("give exactly one of `after`, `every` or `when_done`")
    (when, value), = given.items()

    fd3 = os.fdopen(3, "w")
    if when == "after":
        seconds = span(value)
        say(fd3, detach=f"set: back in {value}, so this turn can end")
        time.sleep(seconds)
        say(fd3, result=prompt)
    elif when == "every":
        seconds = span(value)
        if seconds < 60:
            fail("`every` is at least 1m")
        say(fd3, detach=f"set: back every {value} until stopped, so this turn can end")
        while True:
            say(fd3, status=f"next in {value}")
            time.sleep(seconds)
            say(fd3, result=prompt)
    else:
        say(fd3, detach=f"set: back when `{value}` exits, so this turn can end")
        say(fd3, status=f"waiting on `{value}`")
        say(fd3, result=f"{prompt}\n\n{watch(value)}")


main()
